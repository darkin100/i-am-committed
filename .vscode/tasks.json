{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cargo",
            "command": "build",
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "label": "rust: cargo build"
        },
        {
            "type": "cargo",
            "command": "build",
            "args": [
                "--release"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": "build",
            "label": "rust: cargo build --release"
        },
        {
            "type": "cargo",
            "command": "check",
            "problemMatcher": [
                "$rustc"
            ],
            "group": "build",
            "label": "rust: cargo check"
        },
        {
            "type": "cargo",
            "command": "clean",
            "problemMatcher": [],
            "label": "rust: cargo clean"
        },
        {
            "type": "cargo",
            "command": "run",
            "problemMatcher": [
                "$rustc"
            ],
            "label": "rust: cargo run"
        },
        {
            "type": "cargo",
            "command": "run",
            "args": [
                "--",
                "-v"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "label": "rust: cargo run (verbose)"
        },
        {
            "type": "cargo",
            "command": "test",
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "label": "rust: cargo test"
        },
        {
            "type": "cargo",
            "command": "test",
            "args": [
                "--",
                "--nocapture"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "label": "rust: cargo test (with output)"
        },
        {
            "type": "cargo",
            "command": "clippy",
            "problemMatcher": [
                "$rustc"
            ],
            "label": "rust: cargo clippy"
        },
        {
            "type": "cargo",
            "command": "fmt",
            "problemMatcher": [],
            "label": "rust: cargo fmt"
        }
    ]
}
